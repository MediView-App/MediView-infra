# ===== 이미지 태그 =====
# 배포할 불변 이미지 태그. 운영 배포는 deploy 워크플로가 커밋 SHA 로 이 값을 덮어쓴다.
# (compose 는 값이 비면 기동을 거부한다 — 실수로 :latest 가 붙는 것을 방지)
IMAGE_TAG=latest

# ===== DB =====
DB_NAME=mediview
DB_USER=mediview
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password

# ===== 백엔드 시크릿 =====
# openssl rand -base64 32
JWT_SECRET=change-me-base64-32bytes
APP_ENCRYPTION_KEY=change-me-base64-32bytes
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.mediview.example.com

# ===== TURN / coturn =====
EXTERNAL_IP=203.0.113.10
TURN_REALM=turn.mediview.example.com
# 백엔드 TURN_STATIC_AUTH_SECRET 과 동일해야 함. openssl rand -hex 32
TURN_SECRET=change-me-turn-secret

# ===== AI (선택) =====
OPENAI_API_KEY=

# DB 백업 보존일수
BACKUP_RETENTION_DAYS=7

# 오프사이트 백업 rclone 원격(profile offsite 사용 시)
RCLONE_REMOTE=s3remote:mediview-backups
